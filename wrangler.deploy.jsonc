{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee-platform-baghdad-beta",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_PUBLISHABLE_KEY"
    ]
  },
  "cache": {
    "enabled": true
  }
}
